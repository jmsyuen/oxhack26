# CHOKEPOINT optional services. Copy to .env.local and fill in what you have.
# Everything works without keys: briefs fall back to a built-in template, speech to the
# browser voice, and live prices are simply hidden. Keys are only read by server routes in app/api.

# Google Gemini: writes the "Brief me" script. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any generateContent-capable model id; change it if this one is retired.
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs: reads the brief aloud with word timings. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Default voice "Rachel". Any voice id from your ElevenLabs library works.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# FRED (St. Louis Fed): latest Brent, Asian LNG and wheat prices. https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
